# Local release evidence only: never installs, writes or signs anything.
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED SDK_PREFIX OR NOT IS_DIRECTORY "${SDK_PREFIX}")
  message(FATAL_ERROR "Set SDK_PREFIX to a dedicated installed Linux SDK")
endif()
file(REAL_PATH "${SDK_PREFIX}" prefix)
file(GLOB top RELATIVE "${prefix}" "${prefix}/*")
foreach(entry IN LISTS top)
  if(NOT entry MATCHES "^(include|lib|lib64|share)$" OR NOT IS_DIRECTORY "${prefix}/${entry}" OR IS_SYMLINK "${prefix}/${entry}")
    message(FATAL_ERROR "Not a dedicated SDK prefix: ${entry}")
  endif()
endforeach()
file(GLOB_RECURSE files RELATIVE "${prefix}" "${prefix}/*")
list(SORT files)
set(manifest "pcinsight-linux-sdk-payload-v1\n")
set(archives 0)
set(configs 0)
foreach(path IN LISTS files)
  if(NOT path MATCHES "^include/pcinsight/[A-Za-z0-9_]+\\.hpp$|^lib(64)?/([A-Za-z0-9_-]+/)*libpcinsight\\.a$|^lib(64)?/([A-Za-z0-9_-]+/)*cmake/pcinsight/pcinsight[A-Za-z0-9_-]*\\.cmake$|^share/licenses/pcinsight/LICENSE$")
    message(FATAL_ERROR "Unexpected SDK payload: ${path}")
  endif()
  file(REAL_PATH "${prefix}/${path}" resolved)
  cmake_path(IS_PREFIX prefix "${resolved}" NORMALIZE inside)
  if(NOT inside OR IS_SYMLINK "${prefix}/${path}" OR IS_DIRECTORY "${prefix}/${path}")
    message(FATAL_ERROR "Invalid payload path: ${path}")
  endif()
  if(path MATCHES "/libpcinsight\\.a$")
    math(EXPR archives "${archives}+1")
  elseif(path MATCHES "/pcinsightConfig\\.cmake$")
    math(EXPR configs "${configs}+1")
  endif()
  file(SHA256 "${resolved}" digest)
  string(APPEND manifest "${digest}  ${path}\n")
endforeach()
if(NOT archives EQUAL 1 OR NOT configs EQUAL 1 OR NOT EXISTS "${prefix}/include/pcinsight/sdk_headers.hpp" OR NOT "share/licenses/pcinsight/LICENSE" IN_LIST files)
  message(FATAL_ERROR "Expected one archive, one package config, the SDK header marker and the PCInsight license")
endif()

if(DEFINED EXPECTED_MANIFEST)
  file(READ "${EXPECTED_MANIFEST}" expected)
  string(REPLACE "\r\n" "\n" expected "${expected}")
  if(NOT manifest STREQUAL expected)
    string(REPLACE "\n" ";" actual_lines "${manifest}")
    string(REPLACE "\n" ";" expected_lines "${expected}")
    list(LENGTH actual_lines actual_count)
    list(LENGTH expected_lines expected_count)
    if(NOT actual_count EQUAL expected_count)
      message(FATAL_ERROR "Payload mismatch: manifest line count changed")
    endif()
    math(EXPR last "${actual_count}-1")
    foreach(i RANGE 0 ${last})
      list(GET actual_lines ${i} actual_line)
      list(GET expected_lines ${i} expected_line)
      if(NOT actual_line STREQUAL expected_line)
        string(REGEX REPLACE "^[a-f0-9]+  " "" label "${actual_line}")
        message(FATAL_ERROR "Payload mismatch: ${label}")
      endif()
    endforeach()
    message(FATAL_ERROR "Payload mismatch: invalid manifest formatting")
  endif()
  message(STATUS "Installed payload matches the recorded manifest")
else()
  # message() writes to stderr. Capture only a successful run's output.
  string(REGEX REPLACE "\n$" "" printable "${manifest}")
  message("${printable}")
endif()
